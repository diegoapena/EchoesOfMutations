public void FindBarricade()
{
    // +1 llamada al método
    ClearBarricades();

    // +2 comparaciones
    if (CurrentBarricade == null && barricades.Count > 0)
    {
        // +2 (acceso al índice y asignación)
        Barricade nearestBarricade = barricades[0];

        // +1 asignación
        Vector3 pos = transform.position;

        // +1 inicialización del foreach
        // +(N+1) comparaciones
        foreach (Barricade barricade in barricades)
        {
            // +2 llamadas a Distance
            // +1 comparación
            if (Vector3.Distance(pos, barricade.transform.position) <
                Vector3.Distance(pvos, nearestBarricade.transform.position))
            {
                // +1 asignación
                nearestBarricade = barricade;
            }

            // +1 asignación
            CurrentBarricade = nearestBarricade;
        }
    }
}

