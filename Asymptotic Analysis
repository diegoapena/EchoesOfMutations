public bool Craft(ItemRecipe recipe, Vector3 spawnPosition)
{
    // +1 asignación
    spawnPosition = SpawnPos;

    // +1 llamada a CanCraft
    if (!CanCraft(recipe))
    {
        // +1 return
        return false;
    }

    // +1 inicialización del foreach
    // +(N+1) comparaciones
    foreach (var ingredient in recipe.Ingredients)
    {
        // +2 (acceso al Dictionary y resta/asignación)
        materials[ingredient.material] -= ingredient.amount;

        // +1 comparación
        if (ingredient.material.MaterialName == "Wood")
        {
            // +2 (resta y asignación)
            CurrentWood -= ingredient.amount;
        }
        // +1 comparación
        else if (ingredient.material.MaterialName == "Metal")
        {
            // +2 (resta y asignación)
            CurrentMetal -= ingredient.amount;
        }
        // +1 comparación
        else if (ingredient.material.MaterialName == "Scrap")
        {
            // +2 (resta y asignación)
            CurrentScrap -= ingredient.amount;
        }
    }

    // +1 Instantiate
    Instantiate(recipe.resultPrefab, SpawnPos, Quaternion.identity);

    // +1 return
    return true;
}

