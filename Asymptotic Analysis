public bool CanCraft(ItemRecipe recipe)
{
    // +1 inicialización del foreach
    // +(N+1) comparaciones
    foreach (var ingredient in recipe.Ingredients)
    {
        // +1 TryGetValue
        // +1 comparación (count < ingredient.amount)
        if (!materials.TryGetValue(ingredient.material, out int count) ||
            count < ingredient.amount)
        {
            // +1 return
            return false;
        }
    }

    // +1 return
    return true;
}

