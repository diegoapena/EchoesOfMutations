private IEnumerator WaveCountdown(float duration)
{
    // +1 por asignación
    float remaining = duration;

    // +1 inicialización de la condición
    // +(N+1) comparaciones del while
    while (remaining > 0f)
    {
        // +1 llamada al evento
        OnWaveCountDown?.Invoke(remaining);

        // +2 (resta y asignación)
        remaining -= Time.deltaTime;

        // +1 suspensión de la corrutina
        yield return null;
    }

    // +1 llamada final al evento
    OnWaveCountDown?.Invoke(0f);
}

